{
  "AllowedHosts": "api.yourdomain.com;localhost",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "ClientRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "ClientIdHeader": "x-client-ip",
    "HttpStatusCode": 429,
    "EndpointWhitelist": [
      "get:/health",
      "*:/openapi/*"
    ],
    "ClientWhitelist": [],
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1s", "Limit": 40 },
      { "Endpoint": "*", "Period": "15m", "Limit": 1000 },
      { "Endpoint": "*", "Period": "12h", "Limit": 20000 },
      { "Endpoint": "*", "Period": "7d", "Limit": 10000000 },
      { "Endpoint": "post:/api/v*/products", "Period": "1m", "Limit": 20 },
      { "Endpoint": "post:/api/v*/products", "Period": "1h", "Limit": 200 },
      { "Endpoint": "delete:/api/v*/products/*", "Period": "1m", "Limit": 10 },
      { "Endpoint": "delete:/api/v*/products/*", "Period": "1h", "Limit": 50 }
    ]
  }
}
