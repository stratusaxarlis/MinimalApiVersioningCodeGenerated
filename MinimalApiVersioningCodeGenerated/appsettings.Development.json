{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "ClientRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1s", "Limit": 1000 }
    ]
  }
}
